# region model_provider
SILICONFLOW_API_KEY=  # 推荐使用硅基流动免费服务 https://cloud.siliconflow.cn/i/Eo5yTHGJ
TAVILY_API_KEY=  # 获取搜索服务的 api key 请访问 https://app.tavily.com/

# JWT 安全配置：首次部署请生成随机值，初始化脚本会在留空时自动生成
YUXI_ENV=development
JWT_SECRET_KEY=

# 敏感凭据静态加密主密钥（模型 API Key/OCR Token 等，AES-256-GCM）。生产必填，至少 32 字符：
# openssl rand -hex 32。轮换会使已加密凭据不可解，请先解密再轮换或制定迁移方案。
YUXI_SECRET_MASTER_KEY=
YUXI_INSTANCE_ID=

# Web 对外地址：设备码登录会用它生成浏览器授权链接。
# 生产环境必须填写实际 HTTPS 站点，例如 https://rice.example.com
# 设备码审批页地址：必须指向 Web 前端实际暴露的宿主端口。
# 本仓库 compose 默认映射 5173；如需 5175 请在本地 override 中为 web 服务追加 "5175:5173"。
YUXI_PUBLIC_WEB_URL=http://localhost:5175

# 自助注册默认关闭；可选邀请码和注册后自动绑定的部门 ID。
REGISTER_ENABLED=false
REGISTER_INVITE_CODE=
REGISTER_DEPARTMENT_ID=

# CORS allowed origins for browser clients, comma-separated.
# Development defaults to http://localhost:5173,http://127.0.0.1:5173 when unset.
# Production does not allow cross-origin browser requests unless this is explicitly set.
YUXI_CORS_ORIGINS=

# # 其余可选配置
# OPENAI_API_KEY=
# OPENAI_API_BASE=
# ZHIPUAI_API_KEY=
# DASHSCOPE_API_KEY=
# DEEPSEEK_API_KEY=
# ARK_API_KEY=
# MINIMAX_API_KEY=  # MiniMax 大模型 https://platform.minimaxi.com/
# TOGETHER_API_KEY=
# # endregion model_provider

# Production credentials (required by docker-compose.prod.yml)
POSTGRES_PASSWORD=
# RLS 角色引导（可选，见 docs/ops/rls-activation-runbook.md）：只在 postgres 数据目录
# 首次初始化时创建 yuxi_migrator/yuxi_app，不改变运行时连接；留空时 dev compose 使用开发默认值。
YUXI_MIGRATOR_PASSWORD=
YUXI_APP_PASSWORD=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# Public images use the frontend same-origin proxy by default.
# MINIO_PUBLIC_URL=/minio

# # region neo4j
# NEO4J_URI=
# NEO4J_USERNAME=
NEO4J_PASSWORD=
# # endregion neo4j

# # Servies
# YUXI_SUPER_ADMIN_NAME=
# YUXI_SUPER_ADMIN_PASSWORD=

# Execution trace retention. STANDARD traces are purged as whole runs by the
# worker's daily bounded job; EXTENDED and LEGAL_HOLD traces are never removed.
# TRACE_RETENTION_DAYS=90
# TRACE_RETENTION_BATCH_RUNS=100
# TRACE_RETENTION_MAX_BATCHES=20

# LangGraph checkpointer 存储：postgres（compose 默认，与 lifespan 的 PG 建表一致）或 sqlite。
# 显式 postgres 构建失败会直接终止 agent 编译（fail-closed），不再静默回退 sqlite/内存。
# LANGGRAPH_CHECKPOINTER_BACKEND=postgres

# # URL Whitelist (comma-separated domains/IPs, empty to disable URL parsing)
# YUXI_URL_WHITELIST=github.com,docs.example.com,gitlab.example.com,127.0.0.1

# # MinerU 官方 API（可选，仅首次启动导入；推荐在系统设置页面配置）
# MINERU_API_TOKEN=

# # 科研 PDF 题录/参考文献增强（容器内默认地址；使用 pdf-evidence profile 启动）
# GROBID_URL=http://grobid:8070
# GROBID_VERSION=0.9.1
# GROBID_TIMEOUT_SECONDS=180
# GROBID_IMAGE=grobid/grobid:0.9.1-full
# 单个 Worker 同时执行的科研 PDF 解析数；建议 1-2，硬上限 8
# SCIENTIFIC_PDF_MAX_CONCURRENCY=2

# # PaddleOCR API
# PADDLEOCR_API_TOKEN=
# PADDLEOCR_API_URL=https://paddleocr.aistudio-app.com/api/v2/ocr/jobs

# Sandbox (deerFlow-style provisioner)
# SANDBOX_PROVIDER=provisioner
# SANDBOX_PROVISIONER_URL=http://sandbox-provisioner:8002
# 必填，至少 32 个字符；可使用 `openssl rand -hex 32` 生成
SANDBOX_PROVISIONER_TOKEN=
# SANDBOX_VIRTUAL_PATH_PREFIX=/home/gem/user-data
# SANDBOX_EXEC_TIMEOUT_SECONDS=180
# SANDBOX_MAX_OUTPUT_BYTES=262144

# Server-Grade BioMCP
# Development may launch pinned uvx/npx commands. Production compose always forces false.
ALLOW_DEVELOPMENT_MCP_RUNTIME=true
# Remote endpoints require HTTPS and public DNS. Keep this false outside isolated tests.
YUXI_MCP_ALLOW_INSECURE_HTTP=false
# External authenticated providers. Without them, package/OCI/long-compute work remains
# in BUILD_REQUIRED instead of silently executing on the API host.
YUXI_MCP_BUILDER_URL=
YUXI_MCP_BUILDER_TOKEN=
YUXI_MCP_RUNTIME_URL=
YUXI_MCP_RUNTIME_TOKEN=
YUXI_BIOCOMPUTE_BROKER_URL=
YUXI_BIOCOMPUTE_BROKER_TOKEN=

# Rice Source KB（内置 MCP "ricekb"）：由 Rice Research Agent 的 rice-kb-gateway 提供，
# 水稻 MSU/Oryzabase/RAP-DB 34 张无损源表的只读、带 provenance 的访问。
# 每个消费平台一个 token；在 Rice 仓库执行 .\rice-kb-gateway\scripts\show-caller-token.ps1 -Caller yuxi 获取。
RICE_KB_API_TOKEN=
# 缺省经共享 docker 网络 rice-kb-consumers 直连网关；本机快速联调可改为 http://host.docker.internal:8090。
RICE_KB_GATEWAY_URL=http://rice-kb-gateway:8080
# 飞书/Lark 官方 OpenAPI MCP（内置 "feishu"）：应用凭证（租户级共享；也可由用户
# 经 MCP 凭据管理按人提供同名条目）。在飞书开放平台创建企业自建应用后获取，
# 需开通机器人能力并按需申请 im/docx/bitable 等权限。
# LARK_MCP_APP_ID=
# LARK_MCP_APP_SECRET=
# RICE_KB_CONSUMERS_NETWORK=rice-kb-consumers
# SANDBOX_KEEPALIVE_INTERVAL_SECONDS=30
# SANDBOX_IDLE_TIMEOUT_SECONDS=120
# SANDBOX_IDLE_CHECK_INTERVAL_SECONDS=10
# # sandbox-provisioner backend: memory | docker | kubernetes
# SANDBOX_PROVISIONER_BACKEND=docker

# sandbox-provisioner 通用配置
# SANDBOX_IMAGE=enterprise-public-cn-beijing.cr.volces.com/vefaas-public/all-in-one-sandbox:latest
# SANDBOX_CONTAINER_PORT=8080
# SANDBOX_HEALTH_TIMEOUT_SECONDS=300
# MEMORY_SANDBOX_URL_TEMPLATE=http://agent-sandbox:8000
# SANDBOX_HTTP_PROXY=http://host.docker.internal:7897
# SANDBOX_HTTPS_PROXY=http://host.docker.internal:7897

# Docker backend 专用 (used when SANDBOX_PROVISIONER_BACKEND=docker)
# 动态沙箱专用网络，不要与 app-network 使用同一个名称
# APP_DOCKER_NETWORK=yuxi-know_app-network
# SANDBOX_DOCKER_NETWORK_PREFIX=yuxi-know-sandbox
# SANDBOX_DOCKER_THREADS_HOST_PATH=
# SANDBOX_DOCKER_SANDBOX_PREFIX=yuxi-sandbox

# Kubernetes backend 专用 (used when SANDBOX_PROVISIONER_BACKEND=kubernetes)
# SANDBOX_K8S_NAMESPACE=yuxi-know
# SANDBOX_NODE_HOST=host.docker.internal
# KUBECONFIG_PATH=/root/.kube/config
# THREAD_PVC=yuxi-thread
# SKILLS_PVC=yuxi-skills  # 当前代码会读取，但 Pod 挂载实际仍只使用 THREAD_PVC
