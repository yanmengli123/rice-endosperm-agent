{
  "manifest_version": 3,
  "name": "语析本机浏览器连接",
  "description": "把本机 Chrome/Edge 浏览器接入语析(Yuxi)Browser Gateway,在任务窗口内安全执行服务端下发的浏览操作。",
  "version": "0.1.0",
  "minimum_chrome_version": "125",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "语析本机浏览器连接"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}